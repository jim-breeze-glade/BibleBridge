{
  "name": "biblebridge-backend",
  "version": "1.0.0",
  "description": "BibleBridge Backend API - Comprehensive Bible study platform backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "dev:simple": "nodemon src/simpleApp.ts",
    "build": "tsc",
    "build:simple": "npx tsc src/simpleApp.ts --outDir dist --target es2020 --module commonjs --esModuleInterop --resolveJsonModule --skipLibCheck",
    "start": "node dist/app.js",
    "start:simple": "node dist/simpleApp.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": ["bible", "api", "tts", "pronunciation", "backend"],
  "author": "BibleBridge Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "node-cache": "^5.1.2",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.1.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}